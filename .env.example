# FlowAlchemy — local demo / small-prod Docker setup.
# 1. cp .env.example .env
# 2. Generate secrets: openssl rand -hex 32   (SECRET_KEY, min 16 chars — app validates)
#                      openssl rand -hex 16   (POSTGRES_PASSWORD)
# 3. docker compose up --build
#
# Compose fails fast with a clear message if a required var is missing
# (the `:?` operator), instead of booting with an insecure default.

# --- Required: Flask/JWT signing key, min 16 chars. Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_ME_generate_with_openssl_rand_hex_32

# --- Required: Postgres password. Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=REPLACE_ME_generate_with_openssl_rand_hex_16

# --- Optional: CORS origins (comma-separated). Default is dev-friendly localhost set.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# --- Optional: override full URLs (defaults target the compose service names).
# DATABASE_URL is derived from POSTGRES_PASSWORD automatically — set this only
# if you use an external/managed database instead of the compose postgres service.
# DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/flowalchemy
# REDIS_URL=redis://redis:6379/0

# --- Optional: Redis auth (see note in docker-compose.yml — off by default for dev).
# If you enable `requirepass` on redis, set both lines below:
# REDIS_PASSWORD=
# REDIS_URL=redis://:YOUR_REDIS_PASSWORD@redis:6379/0

# --- Optional: migration retry tuning (defaults: 30 tries x 2s).
# MIGRATION_MAX_RETRIES=30
# MIGRATION_RETRY_INTERVAL=2
