# App
SECRET_KEY=your-secret-key-here-min-16-chars
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowalchemy
REDIS_URL=redis://localhost:6379/0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80

# Encryption (optional — derived from SECRET_KEY if not set)
# CREDENTIAL_ENCRYPTION_KEY=your-fernet-key-here

# Worker
WORKER_POLL_INTERVAL=1.0

# Retry
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2
RETRY_JITTER=0.5

# Node-level retry
NODE_MAX_RETRIES=2

# Timeout
WORKFLOW_TIMEOUT=300
NODE_TIMEOUT=30

# Resource Limits
MAX_CONCURRENT_PER_USER=5
MAX_CONCURRENT_TOTAL=10
MAX_NODES_PER_WORKFLOW=50
MAX_PAYLOAD_SIZE=1048576
MAX_RESPONSE_SIZE=10485760
